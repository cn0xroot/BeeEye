{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BeeEye-desktop",
  "version": "0.1.0",
  "identifier": "io.beeeye.desktop",
  "build": {
    "frontendDist": "dist-placeholder"
  },
  "app": {
    "windows": [
      {
        "title": "蜂眼 BeeEye",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
