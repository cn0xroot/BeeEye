  "mitm": {
    "title": "手机/电脑端可选解密",
    "intro": "装一张本机生成的根证书，把设备的 HTTPS 代理指向下面这个地址，就能看到那台设备自己的明文流量——跟 Surge、Burp、mitmproxy 是同一套用法。没装证书的设备，连接会直接失败，不会被静默放行成明文。",
    "disabledTitle": "还没开启。",
    "disabledBody": "在 config.yaml 里把下面这段加上（或把 enabled 改成 true），重启 agent 即可。",
    "proxyAddress": "代理地址",
    "proxyAddressHint": "在设备的 Wi-Fi/HTTPS 代理设置里填这个",
    "fingerprint": "证书指纹",
    "fingerprintHint": "装完之后，可以拿这个跟设备上显示的做个对照",
    "exchanges": "已解密的请求数",
    "downloadTitle": "下载根证书",
    "downloadPem": "下载证书（PEM）",
    "downloadMobileConfig": "下载 iOS/macOS 描述文件",
    "downloadHint": "iPhone/iPad/Mac 优先用右边这个，安装提示会带名称和说明，不是一个陌生文件名。Android/Windows 用左边那个。",
    "platformTitle": "装上证书之后，还要做什么",
    "platform": "平台",
    "platformCaveat": "需要注意的地方",
    "platforms": {
      "android": {
        "name": "Android",
        "caveat": "设置里走「安装证书→CA 证书」就行，但 Android 7 以上默认只信任系统预装的根证书——用户装的证书，很多做了证书锁定的 App（银行、部分社交类）不会认，只有系统浏览器等普通应用才会被解密。"
      },
      "ios": {
        "name": "iOS / iPadOS",
        "caveat": "装完描述文件后还要手动去一趟：设置→通用→关于本机→证书信任设置，把这张证书的「完全信任」打开——这是苹果对所有用户新增证书的强制要求，装完不代表已经生效。"
      },
      "macos": {
        "name": "macOS",
        "caveat": "双击证书会打开钥匙串访问，同样要手动把它的信任设置改成「始终信任」，默认的「系统默认」不会生效。"
      },
      "windows": {
        "name": "Windows",
        "caveat": "双击证书进导入向导时，务必手动选到「受信任的根证书颁发机构」这个位置——选进「个人」的话装了也没用。"
      },
      "firefox": {
        "name": "任意系统上的 Firefox",
        "caveat": "Firefox 有自己独立的证书库，不读取系统信任链，得在 Firefox 设置里单独再导入一次这张证书，否则系统层面装好了，Firefox 里还是会报证书错误。"
      }
    },
